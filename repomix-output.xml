#include "game.h"
#include "menu.h"
#include "v_card.h"
#include "i8042.h"
#include "proj.h"
#include <stdlib.h>
#include "font.h"
#include "entities.h"
#include "rtc.h"
#include <stdio.h>
#include <string.h>

// Global variables for wave system
Wave level_waves[MAX_WAVES];
int total_waves = 0;
int current_wave = 0;
int wave_timer = 0;
int current_level = 1;

// screen dimensions
#define SCREEN_W 800
#define SCREEN_H 600


#define COLOR_BG      0x228B22
#define COLOR_UI      0x3b4d24
#define COLOR_CELL    0x32CD32
#define COLOR_PLANT   0x00FF00
#define COLOR_CURSOR  0xFFFFFF

static GameState current_state = MAIN_MENU;

#define GRID_COLS 9
#define GRID_ROWS 5
#define CELL_SIZE 80
#define GRID_START_X 40
#define GRID_START_Y 150

//Levels page constants
#define SQ_SIZE 60
#define SQ_GAP 20
#define SQ_START_X 210
#define SQ_START_Y 200

// mouse state
static int16_t mouse_x, mouse_y;
static bool prev_lb = false; // store if left btn was pressed in last frame
#define CURSOR_SIZE 8

static int grid[GRID_ROWS][GRID_COLS];

static bool quit = false;

// game entities and state
static plant_cell_t plant_grid[5][9];
static int suns_count = 150;
static int score = 0;
static int level = 1;
static int selected_plant = 1;  // 1=sunflower, 2=peashooter
static bool frozen = false;
static uint32_t freeze_timer = 0;
static int suns_spent = 0;

// wave spawning
static int zombies_to_spawn = 0;
static uint32_t spawn_timer = 0;
static bool wave_active = false;

// RTC
static uint32_t rtc_timer = 0;
static rtc_date current_time;
#define ESC_BREAKCODE 0x81

void game_change_state(GameState new_state) {
    current_state = new_state;
}

void game_set_quit() {
    quit = true;
}

void game_init() {
    mouse_x = SCREEN_W / 2;
    mouse_y = SCREEN_H / 2;

    for (int r = 0; r < GRID_ROWS; r++) {
        for (int c = 0; c < GRID_COLS; c++) {
            grid[r][c] = 0;
        }
    }

    entities_init();

    suns_count = 150;
    score = 0;
    level = 1;
    selected_plant = 1;
    frozen = false;
    freeze_timer = 0;
    zombies_to_spawn = 0;
    spawn_timer = 0;
    wave_active = false;
    rtc_timer = 0;
    suns_spent = 0;

    for (int r = 0; r < GRID_ROWS; r++) {
        for (int c = 0; c < GRID_COLS; c++) {
            plant_grid[r][c].type = 0;
            plant_grid[r][c].hp = 0;
            plant_grid[r][c].shoot_timer = 0;
            plant_grid[r][c].sun_timer = 0;
        }
    }

    rtc_read_date(&current_time);

    srand(current_time.seconds + current_time.minutes * 60);
}

void game_init_level(int level_number) {
    current_level = level_number;

    total_waves = 0;
    current_wave = 0;
    wave_timer = 5 * 60; // fallback initial delay

    entities_init();
    memset(plant_grid, 0, sizeof(plant_grid));

    suns_count = 50;
    score = 0;
    suns_spent = 0;
    frozen = false;
    freeze_timer = 0;
    selected_plant = 1;

    char filepath[256];
#ifdef LEVEL_PATH
    snprintf(filepath, sizeof(filepath), LEVEL_PATH "/level%d.txt", level_number);
#else
    snprintf(filepath, sizeof(filepath), "../levels/level%d.txt", level_number);
#endif

    FILE *file = fopen(filepath, "r");
    if (!file) {
        printf("Warning: Could not open %s\n", filepath);
        if (level_number == 1) {
            wave_timer = 5 * 60;
            total_waves = 2;
            level_waves[0].num_zombies = 2;
            level_waves[0].spawns[0].type = 1; level_waves[0].spawns[0].lane = 1;
            level_waves[0].spawns[1].type = 1; level_waves[0].spawns[1].lane = 2;
            level_waves[0].time_to_next_wave = 3 * 60;
            level_waves[1].num_zombies = 1;
            level_waves[1].spawns[0].type = 1; level_waves[1].spawns[0].lane = 2;
            level_waves[1].time_to_next_wave = 3 * 60;
        } else {
            wave_timer = 5 * 60;
            total_waves = 2;
            level_waves[0].num_zombies = 2;
            level_waves[0].spawns[0].type = 1; level_waves[0].spawns[0].lane = 1;
            level_waves[0].spawns[1].type = 1; level_waves[0].spawns[1].lane = 3;
            level_waves[0].time_to_next_wave = 5 * 60;
            level_waves[1].num_zombies = 3;
            level_waves[1].spawns[0].type = 1; level_waves[1].spawns[0].lane = 0;
            level_waves[1].spawns[1].type = 1; level_waves[1].spawns[1].lane = 2;
            level_waves[1].spawns[2].type = 1; level_waves[1].spawns[2].lane = 4;
            level_waves[1].time_to_next_wave = 5 * 60;
        }
        return;
    }
    printf("Opened level file: %s\n", filepath);

    char line[512];
    int initial_delay = 5; // default if first line is missing/unparseable

    // First non-empty line: time before first wave (seconds)
    while (fgets(line, sizeof(line), file)) {
        if (line[0] == '\n' || line[0] == '\r' || line[0] == '\0') continue;
        sscanf(line, "%d", &initial_delay);
        break;
    }

    // Remaining lines: one wave per line
    // Format: num_zombies,(type,lane)(type,lane)...,time_to_next_wave
    while (fgets(line, sizeof(line), file)) {
        if (total_waves >= MAX_WAVES) break;
        if (line[0] == '\n' || line[0] == '\r' || line[0] == '\0') continue;

        Wave *w = &level_waves[total_waves];
        char *ptr = line;

        // A. Number of zombies
        if (sscanf(ptr, "%d", &w->num_zombies) != 1) continue;
        ptr = strchr(ptr, ',');
        if (!ptr) continue;
        ptr++;

        if (w->num_zombies > MAX_ZOMBIES_PER_WAVE)
            w->num_zombies = MAX_ZOMBIES_PER_WAVE;

        // B. Zombie entries: (type,lane)(type,lane)...
        for (int i = 0; i < w->num_zombies; i++) {
            int offset = 0;
            if (sscanf(ptr, "(%d,%d)%n",
                       &w->spawns[i].type,
                       &w->spawns[i].lane,
                       &offset) == 2) {
                ptr += offset;
            }
        }

        // C. Time to next wave
        while (*ptr == ',' || *ptr == ' ') ptr++;
        int time_sec = 0;
        if (sscanf(ptr, "%d", &time_sec) == 1) {
            w->time_to_next_wave = time_sec * 60;
        } else {
            w->time_to_next_wave = 10 * 60;
        }

        printf("Loaded wave %d: %d zombies, next in %d ticks\n",
               total_waves, w->num_zombies, w->time_to_next_wave);
        total_waves++;
    }

    fclose(file);

    // Set the initial delay AFTER parsing, so it is never overwritten
    wave_timer = initial_delay * 60;

    printf("Level %d loaded: %d waves, initial delay %d ticks\n",
           level_number, total_waves, wave_timer);
}

void game_update_waves() {
    if (total_waves == 0) return;

    if (current_wave >= total_waves) {
        // All waves dispatched. Count down the post-last-wave timer before
        // allowing completion, so the last wave's zombies have time to appear.
        if (wave_timer > 0) {
            wave_timer--;
        } else if (entities_zombies_alive() == 0) {
            game_change_state(LEVEL_COMPLETE);
        }
        return;
    }

    if (wave_timer > 0) {
        wave_timer--;
        return; // Still counting down - don't spawn yet.
    }

    // wave_timer == 0: time to spawn this wave.
    {
        Wave *w = &level_waves[current_wave];
        
        // 1. Take a snapshot of which zombie slots are currently empty
        bool was_empty[MAX_ZOMBIES];
        for (int z = 0; z < MAX_ZOMBIES; z++) {
            was_empty[z] = !zombies[z].active;
        }

        // 2. Spawn all zombies for this wave (they will temporarily overlap)
        for (int i = 0; i < w->num_zombies; i++) {
            uint8_t lane = (uint8_t)(w->spawns[i].lane);
            if (lane >= GRID_ROWS) lane = GRID_ROWS - 1; // clamp to valid row
            spawn_zombie(lane, current_level);
        }
        
        // 3. Find the newly spawned zombies and apply an incremental X offset
        int lane_offsets[5] = {0}; // Tracks how many zombies we've adjusted per lane
        
        for (int z = 0; z < MAX_ZOMBIES; z++) {
            // If the slot was empty before, but is now active, it's a new spawn!
            if (was_empty[z] && zombies[z].active) {
                uint8_t lane = zombies[z].lane;
                
                // Push the zombie further to the right based on how many 
                // others spawned in this lane before it.
                // (e.g., 1st zombie gets +0, 2nd gets +50, 3rd gets +100)
                zombies[z].x += lane_offsets[lane] * 50; 
                
                // Increment the offset multiplier for the next zombie in this lane
                lane_offsets[lane]++; 
            }
        }
        
        wave_timer = w->time_to_next_wave;
        current_wave++;
    }
}

void game_update() {
    if (current_state == PLAYING) {
        game_update_waves();
        if (frozen) {
            if (freeze_timer > 0) {
                freeze_timer--;
            }

            if (freeze_timer == 0) {
                frozen = false;
            }
        }

        bool game_over = entities_update(
            plant_grid,
            &suns_count,
            &score,
            level,
            frozen,
            timer_counter
        );

        if (game_over) {
            rtc_read_date(&current_time);
            current_state = MAIN_MENU;
        }

        rtc_timer++;
        if (rtc_timer >= 60) {
            rtc_read_date(&current_time);
            rtc_timer = 0;
        }
    }
}

void game_render() {
    if (current_state == MAIN_MENU) {
        menu_render(mouse_x, mouse_y);
    }
    else if (current_state == LEVEL_SELECT) {
        level_select_render(mouse_x, mouse_y);
    }
    else if (current_state == PLAYING) {
        vg_clear(COLOR_BG);

        // top UI bar
        vg_draw_rectangle(0, 0, SCREEN_W, 100, COLOR_UI);

        // draw grid background
        for (int r = 0; r < GRID_ROWS; r++) {
            for (int c = 0; c < GRID_COLS; c++) {
                int cell_x = GRID_START_X + c * CELL_SIZE;
                int cell_y = GRID_START_Y + r * CELL_SIZE;

                vg_draw_rectangle(
                    cell_x + 2,
                    cell_y + 2,
                    CELL_SIZE - 4,
                    CELL_SIZE - 4,
                    COLOR_CELL
                );
            }
        }

        // draw plants
        for (int r = 0; r < GRID_ROWS; r++) {
            for (int c = 0; c < GRID_COLS; c++) {
                int cell_x = GRID_START_X + c * CELL_SIZE;
                int cell_y = GRID_START_Y + r * CELL_SIZE;

                if (plant_grid[r][c].type == 1) {
                    // sunflower
                    vg_draw_rectangle(cell_x + 20, cell_y + 15, 40, 40, 0xFFFF00);
                    vg_draw_rectangle(cell_x + 28, cell_y + 23, 24, 24, 0x8B4513);
                }
                else if (plant_grid[r][c].type == 2) {
                    // peashooter
                    vg_draw_rectangle(cell_x + 20, cell_y + 15, 40, 40, 0x00FF00);
                    vg_draw_rectangle(cell_x + 50, cell_y + 30, 12, 10, 0x228B22);
                }
            }
        }

        // draw zombies, projectiles and suns
        entities_render(GRID_START_X, GRID_START_Y, CELL_SIZE, frozen);

        // HUD
        font_draw_string("SUNS:", 10, 15, 0xFFFF00);
        font_draw_number(suns_count, 80, 15, 0xFFFF00);

        font_draw_string("SCORE:", 200, 15, 0xFFFFFF);
        font_draw_number(score, 280, 15, 0xFFFFFF);

        font_draw_string("LVL:", 400, 15, 0xFFFFFF);
        font_draw_number(level, 450, 15, 0xFFFFFF);

        //draw pant options
        uint32_t sun_color = (selected_plant == 1) ? 0xFFFF00 : 0x888888;
        uint32_t pea_color = (selected_plant == 2) ? 0x00FF00 : 0x888888;

        font_draw_string("1-SUN", 10, 60, sun_color);
        font_draw_string("2-PEA", 110, 60, pea_color);

        if (frozen) {
            font_draw_string("FROZEN", 500, 60, 0x0000FF);
        }

        // RTC time
        char ts[9];
        ts[0] = '0' + current_time.hours / 10;
        ts[1] = '0' + current_time.hours % 10;
        ts[2] = ':';
        ts[3] = '0' + current_time.minutes / 10;
        ts[4] = '0' + current_time.minutes % 10;
        ts[5] = ':';
        ts[6] = '0' + current_time.seconds / 10;
        ts[7] = '0' + current_time.seconds % 10;
        ts[8] = '\0';

        font_draw_string(ts, 680, 15, 0xFFFFFF);
    }
    else if (current_state == LEVEL_COMPLETE) {
        vg_clear(COLOR_BG);

        vg_draw_rectangle(0, 0, SCREEN_W, 100, COLOR_UI);

        // draw grid
        for (int r = 0; r < GRID_ROWS; r++) {
            for (int c = 0; c < GRID_COLS; c++) {
                int cell_x = GRID_START_X + c * CELL_SIZE;
                int cell_y = GRID_START_Y + r * CELL_SIZE;

                vg_draw_rectangle(
                    cell_x + 2,
                    cell_y + 2,
                    CELL_SIZE - 4,
                    CELL_SIZE - 4,
                    COLOR_CELL
                );
            }
        }
        
        // draw results
        font_draw_string("LEVEL COMPLETE!", 300, 250, 0xFF0000);
        
        font_draw_string("SUNS SPENT:", 300, 300, 0xFF0000);
        font_draw_number(suns_spent, 450, 300, 0xFF0000);

        font_draw_string("PRESS ESC TO RETURN", 250, 400, 0xFF0000);
        
        vg_flip();
    }


    // draw mouse 
    vg_draw_rectangle(mouse_x - CURSOR_SIZE / 2, mouse_y - 1, CURSOR_SIZE, 2, COLOR_CURSOR);
    vg_draw_rectangle(mouse_x - 1, mouse_y - CURSOR_SIZE / 2, 2, CURSOR_SIZE, COLOR_CURSOR);

    vg_flip();
}

bool game_should_quit() {
    return quit;
}

void game_on_key(uint8_t scancode) {
    if (current_state == MAIN_MENU) {
        menu_on_key(scancode);
    } 
    else if (current_state == LEVEL_SELECT) {
        if (scancode == 0x81) { 
            current_state = MAIN_MENU;
        }
    }
    else if (current_state == PLAYING) {
        if (scancode == ESC_BREAKCODE) {
            current_state = MAIN_MENU;
        }

        if (scancode == 0x02) {
            selected_plant = 1;
        }

        if (scancode == 0x03) {
            selected_plant = 2;
        }

        if (scancode == 0x39 && !frozen) {
            frozen = true;
            freeze_timer = 180;
        }

    } else if (current_state == LEVEL_COMPLETE) {
        if (scancode == ESC_BREAKCODE) {
            current_state = MAIN_MENU;
        }
    }
}

void game_on_mouse(struct packet *pp) {
    // update mouse
    mouse_x += pp->delta_x;
    mouse_y -= pp->delta_y;

    // mouse limits
    if (mouse_x < 0) mouse_x = 0;
    if (mouse_x >= SCREEN_W) mouse_x = SCREEN_W - 1;
    if (mouse_y < 0) mouse_y = 0;
    if (mouse_y >= SCREEN_H) mouse_y = SCREEN_H - 1;

    //handle click
    if (current_state == MAIN_MENU) {
        menu_on_mouse(pp, mouse_x, mouse_y);
    } 
    else if (current_state == LEVEL_SELECT) {
        static bool lvl_prev_lb = false;
        if (pp->lb && !lvl_prev_lb) {
            
            // Loop through your 10 squares
            for (int i = 0; i < 10; i++) {
                int row = i / 5;
                int col = i % 5;
                int bx = SQ_START_X + col * (SQ_SIZE + SQ_GAP);
                int by = SQ_START_Y + row * (SQ_SIZE + SQ_GAP);

                if (mouse_x >= bx && mouse_x <= bx + SQ_SIZE &&
                    mouse_y >= by && mouse_y <= by + SQ_SIZE) {
                    
                    // Call the parser instead of just assigning a variable!
                    game_init_level(i + 1); 
                    game_change_state(PLAYING);
                    break;
                }
            }
        }
        lvl_prev_lb = pp->lb;
    }
    else if (current_state == PLAYING) {
        if (pp->lb && !prev_lb) {
            // try to collect sun first
            bool sun_collected = entities_collect_sun(mouse_x, mouse_y, &suns_count);

            // plant only if click is inside the grid
            if(!sun_collected){
                if (mouse_x >= GRID_START_X &&
                    mouse_x < GRID_START_X + GRID_COLS * CELL_SIZE &&
                    mouse_y >= GRID_START_Y &&
                    mouse_y < GRID_START_Y + GRID_ROWS * CELL_SIZE) {

                    int col = (mouse_x - GRID_START_X) / CELL_SIZE;
                    int row = (mouse_y - GRID_START_Y) / CELL_SIZE;

                    if (plant_grid[row][col].type == 0) {
                        int cost = selected_plant == 1 ? 50 : 100;

                        if (suns_count >= cost) {
                            plant_grid[row][col].type = selected_plant;
                            plant_grid[row][col].hp = 300;
                            plant_grid[row][col].shoot_timer = 0;
                            plant_grid[row][col].sun_timer = 0;
                            suns_count -= cost;
                            suns_spent += cost;
                        }
                    }
                }
            }
        }
    }

    prev_lb = pp->lb;
}

void level_select_render(int mouse_x, int mouse_y) {
    vg_clear(0x111111);

    font_draw_string("SELECT A LEVEL", 310, 100, 0xFFFFFF);

    // Draw 10 squares arranged into 2 rows of 5
    for (int i = 0; i < 10; i++) {
        int row = i / 5;
        int col = i % 5;
        int bx = SQ_START_X + col * (SQ_SIZE + SQ_GAP);
        int by = SQ_START_Y + row * (SQ_SIZE + SQ_GAP);

        uint32_t color = 0x444444; 
        if (mouse_x >= bx && mouse_x <= bx + SQ_SIZE &&
            mouse_y >= by && mouse_y <= by + SQ_SIZE) {
            color = 0x0088FF; 
        }

        vg_draw_rectangle(bx, by, SQ_SIZE, SQ_SIZE, color);
        
        int text_offset_x = (i == 9) ? 19 : 25; 
        font_draw_number(i + 1, bx + text_offset_x, by + 22, 0xFFFFFF);
    }

    uint32_t back_color = 0x555555;
    if (mouse_x >= 300 && mouse_x <= 500 && mouse_y >= 410 && mouse_y <= 460) {
        back_color = 0x888888;
    }
    vg_draw_rectangle(300, 410, 200, 50, back_color);
    font_draw_string("BACK", 376, 426, 0xFFFFFF);
}
